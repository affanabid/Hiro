# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# Comma-separated hostnames for Django
# For development you usually do not need to set this.
# Example for production:
# DJANGO_ALLOWED_HOSTS=hiro.yourdomain.com

# CORS / CSRF origins (comma-separated URLs)
# For development, the defaults in settings.py cover Vite on 5173/5174.
# Example for production:
# DJANGO_CORS_ALLOWED_ORIGINS=https://hiro.yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hiro.yourdomain.com

# PostgreSQL connection
PGDATABASE=posts
PGUSER=postgres
PGPASSWORD=your_local_password
PGHOST=localhost
PGPORT=5432

